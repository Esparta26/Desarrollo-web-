<%- include('partials/head') %> 

<main class="container mx-auto px-6 py-16 flex justify-center items-center flex-grow">
  <div class="max-w-md w-full bg-white p-10 rounded-3xl shadow-2xl border border-gray-100">
    <div class="text-center mb-10">
      <h2 class="text-4xl font-black italic tracking-tighter uppercase">
        Únete al Crew
      </h2>
      <p class="text-gray-500 text-sm mt-2 font-medium">
        Crea tu cuenta en StyleHub y recibe drops exclusivos.
      </p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 bg-red-50 border border-red-200 rounded-xl p-4">
        <ul class="space-y-1">
          <% errors.forEach(error => { %>
            <li class="text-red-600 text-sm font-medium">• <%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form id="registerForm" action="/register" method="POST" class="space-y-6" novalidate>
      <div>
        <label class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-2 italic">Nombre Completo</label>
        <input type="text" name="fullName" id="fullName" placeholder="Tu nombre"
          class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-black focus:border-black transition outline-none" />
        <p class="text-red-500 text-xs mt-1 hidden" id="fullNameError"></p>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-2 italic">Correo Electrónico</label>
        <input type="email" name="email" id="email" placeholder="ejemplo@correo.com"
          class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-black focus:border-black transition outline-none" />
        <p class="text-red-500 text-xs mt-1 hidden" id="emailError"></p>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-2 italic">Contraseña</label>
        <input type="password" name="password" id="password" placeholder="Mínimo 8 caracteres"
          class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-black focus:border-black transition outline-none" />
        <p class="text-red-500 text-xs mt-1 hidden" id="passwordError"></p>
      </div>

      <button type="submit"
        class="w-full bg-black text-white py-4 rounded-xl font-black uppercase tracking-widest hover:bg-gray-800 transition shadow-xl transform active:scale-95">
        Registrarse
      </button>
    </form>

    <div class="mt-8 text-center pt-6 border-t border-gray-50">
      <p class="text-gray-500 text-sm">
        ¿Ya eres parte del crew?
        <a href="/login" class="text-black font-bold hover:underline">Inicia sesión</a>
      </p>
    </div>
    
  </div>
</main>

<script>
  document.getElementById("registerForm").addEventListener("submit", function (e) {
    let valid = true;

    const fullName = document.getElementById("fullName");
    const fullNameError = document.getElementById("fullNameError");
    const email = document.getElementById("email");
    const emailError = document.getElementById("emailError");
    const password = document.getElementById("password");
    const passwordError = document.getElementById("passwordError");

    fullNameError.classList.add("hidden");
    emailError.classList.add("hidden");
    passwordError.classList.add("hidden");

    if (!fullName.value.trim()) {
      fullNameError.textContent = "El nombre es obligatorio.";
      fullNameError.classList.remove("hidden");
      valid = false;
    } else if (fullName.value.trim().length < 2) {
      fullNameError.textContent = "El nombre debe tener al menos 2 caracteres.";
      fullNameError.classList.remove("hidden");
      valid = false;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email.value.trim()) {
      emailError.textContent = "El email es obligatorio.";
      emailError.classList.remove("hidden");
      valid = false;
    } else if (!emailRegex.test(email.value.trim())) {
      emailError.textContent = "Debe ser un formato de email válido.";
      emailError.classList.remove("hidden");
      valid = false;
    }

    if (!password.value.trim()) {
      passwordError.textContent = "La contraseña es obligatoria.";
      passwordError.classList.remove("hidden");
      valid = false;
    } else if (password.value.length < 8) {
      passwordError.textContent = "La contraseña debe tener al menos 8 caracteres.";
      passwordError.classList.remove("hidden");
      valid = false;
    }

    if (!valid) e.preventDefault();
  });
</script>

<%- include('partials/footer') %>

